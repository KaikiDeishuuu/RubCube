{
  "name": "@rubcube/cube-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Three.js renderer, animation, and pointer interaction for RubCube",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fallback": {
      "development": "./src/fallback.ts",
      "types": "./dist/fallback.d.ts",
      "import": "./dist/fallback.js"
    },
    "./keyboard": {
      "development": "./src/keyboard.ts",
      "types": "./dist/keyboard.d.ts",
      "import": "./dist/keyboard.js"
    },
    "./renderer": {
      "development": "./src/cube-renderer.ts",
      "types": "./dist/cube-renderer.d.ts",
      "import": "./dist/cube-renderer.js"
    },
    "./transport": {
      "development": "./src/transport.ts",
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rubcube/cube-core": "workspace:*",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
