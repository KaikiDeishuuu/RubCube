{
  "name": "@rubcube/cube-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-dependency Rubik's Cube rules engine shared by browser and Node.js",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./solver": {
      "development": "./src/solver/index.ts",
      "types": "./dist/solver/index.d.ts",
      "import": "./dist/solver/index.js"
    },
    "./optimal": {
      "development": "./src/optimal/index.ts",
      "types": "./dist/optimal/index.d.ts",
      "import": "./dist/optimal/index.js"
    },
    "./metrics": {
      "development": "./src/metrics/index.ts",
      "types": "./dist/metrics/index.d.ts",
      "import": "./dist/metrics/index.js"
    }
  },
  "scripts": {
    "bench:search": "tsc -p tsconfig.build.json && node scripts/benchmark-solver-search.mjs",
    "bench:tables": "tsc -p tsconfig.build.json && node scripts/benchmark-solver-tables.mjs",
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "validate:proxy": "tsc -p tsconfig.build.json && node scripts/validate-distance-proxy.mjs",
    "verify:corpus": "tsc -p tsconfig.build.json && node scripts/verify-solver-corpus.mjs",
    "verify:optimal": "tsc -p tsconfig.build.json && node scripts/verify-optimal-corpus.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
